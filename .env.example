# Copier ce fichier en .env.local (ignoré par git) et renseigner les valeurs.
# En production : Vercel → Project → Settings → Environment Variables.
# Ne jamais committer de valeur réelle.

# ── Base de données (Neon) ──────────────────────────────────────────
# Console Neon → projet hnetmedia → Connect. Local : branche `dev` ; Vercel Production : branche `main`.
DATABASE_URL=

# ── Sécurité ────────────────────────────────────────────────────────
# Secret aléatoire d'au moins 32 caractères (sert à rendre les IP non réversibles).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HASH_SECRET=
# Adresse publique du site (liens des e-mails, contrôle d'origine).
SITE_URL=https://www.hnetmedia.com
# Code à usage unique pour créer le premier administrateur sur /admin (24 caractères min.).
# À SUPPRIMER de Vercel une fois le compte créé.
ADMIN_SETUP_TOKEN=

# ── E-mails (Resend — resend.com) ───────────────────────────────────
# Clé d'API : Resend → API Keys (droit « Sending access » suffit).
RESEND_API_KEY=
# Expéditeur. Sans domaine : onboarding@resend.dev (Resend n'envoie alors QU'À l'adresse du compte
# Resend : utile pour recevoir les alertes « nouveau message », pas pour la newsletter).
# Avec un domaine vérifié chez Resend : une adresse de ce domaine, ex. newsletter@votredomaine.com.
EMAIL_FROM=
EMAIL_FROM_NAME=HNet Media
# Adresse qui reçoit une alerte à chaque message du formulaire de contact (facultatif).
CONTACT_NOTIFY_EMAIL=

# ── Rebuild automatique (étape 8) ───────────────────────────────────
# Vercel → Settings → Git → Deploy Hooks (branche main).
VERCEL_DEPLOY_HOOK_URL=

# ── Publication programmée ──────────────────────────────────────────
# Secret d'au moins 24 caractères (32 conseillés). Vercel Cron l'envoie tout seul (une fois par jour) ;
# un service de planification externe peut appeler /api/scheduled toutes les 5 minutes avec
# « Authorization: Bearer <ce secret> » pour publier à l'heure près. Sans lui, le point d'entrée est fermé.
CRON_SECRET=
