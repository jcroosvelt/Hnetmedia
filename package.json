{
  "name": "hnetmedia",
  "version": "1.0.0",
  "private": true,
  "description": "HNet Media — site statique généré par build.js à partir de Neon (PostgreSQL), hébergé sur Vercel",
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js && node serve.js 8000",
    "db:migrate": "node db/migrate.js",
    "db:status": "node db/migrate.js --status",
    "test": "node --test test/*.test.js",
    "build:editor": "esbuild admin-app/editor.src.js --bundle --minify --format=iife --target=es2020 --legal-comments=none --outfile=admin-app/editor.js",
    "test:browser": "node test/browser/e2e.js && node test/browser/roles.js && node test/browser/catalog.js && node build.js && node test/browser/search.js && node test/browser/contact.js && node test/browser/pagination.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "sanitize-html": "2.13.1"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-character-count": "3.33.0",
    "@tiptap/extension-placeholder": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/extension-text-align": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "esbuild": "0.28.2",
    "pg": "^8.23.1"
  }
}
